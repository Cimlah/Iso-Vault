# Iso-Vault settings. install.sh writes .env for you; every value here is optional.

# --- DHCP ---------------------------------------------------------------------
# proxy    : adds boot info alongside your existing DHCP server (no router changes)
# server   : Iso-Vault hands out IP addresses itself (turn off your router's DHCP)
# upstream : no DHCP at all; your router points at this host (see docs/upstream-dhcp.md)
DHCP_MODE=proxy

# server mode refuses to hand out leases if it finds another DHCP server.
# Set to true only if you are certain, because two DHCP servers can disrupt a LAN.
DHCP_FORCE=false

# server mode only. Blank values are worked out from the network.
DHCP_RANGE_START=
DHCP_RANGE_END=
DHCP_GATEWAY=
DHCP_DNS=
DHCP_LEASE_TIME=12h

# --- Network ------------------------------------------------------------------
# auto uses the interface of the default route, and its first IPv4 address.
INTERFACE=auto
SERVER_IP=auto

# --- Ports --------------------------------------------------------------------
# Clients must always reach BOOT_PORT directly. Never put it behind a proxy.
BOOT_PORT=8080
UI_PORT=8081

# Use 127.0.0.1 when a reverse proxy on this host fronts the UI.
UI_BIND=0.0.0.0

# The address people use to open the UI, when it isn't http://<host>:UI_PORT.
# Example: https://isovault.example.com
UI_PUBLIC_URL=

# --- Folders on this host -----------------------------------------------------
ISO_DIR=./isos
DATA_DIR=./data
# Network drivers for Windows ISOs, in x64 and arm64 subfolders.
DRIVERS_DIR=./drivers

# --- ISOs ---------------------------------------------------------------------
# auto tries a read-only loop mount, then falls back to extracting into DATA_DIR.
ISO_ACCESS=auto

# auto enables a share unless its ports are in use. true fails loudly instead.
ENABLE_NFS=auto
ENABLE_SMB=auto

# --- Boot menu ----------------------------------------------------------------
# Seconds before the default entry starts. 0 waits forever.
MENU_TIMEOUT=30
# Path inside ISO_DIR to boot on timeout. Blank means boot from the local disk.
DEFAULT_ISO=
# Appended to every Linux kernel command line, for example console=ttyS0.
EXTRA_KERNEL_ARGS=

# --- Credentials --------------------------------------------------------------
# Generated into DATA_DIR/secrets.json when blank.
ADMIN_PASSWORD=
SESSION_SECRET=
SMB_PASSWORD=

# --- Image --------------------------------------------------------------------
ISO_VAULT_TAG=latest
